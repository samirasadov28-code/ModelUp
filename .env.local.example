# ── Grok (xAI) API ────────────────────────────────────────────────────────────
# Get your key at https://console.x.ai
GROK_API_KEY=xai-...

# ── Authentication (NextAuth.js) ───────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-min-32-chars

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...

# ── Python Excel Microservice ──────────────────────────────────────────────────
# Run locally: cd excel-service && uvicorn main:app --port 8000
# Or deploy to Railway/Fly.io
PYTHON_SERVICE_URL=http://localhost:8000

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature flags ──────────────────────────────────────────────────────────────
# Set to "true" to require Stripe subscription before showing full model
NEXT_PUBLIC_GATE_ENABLED=false
