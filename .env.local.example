# ModelUp — Environment Variables Reference
# Copy to .env.local and fill in your values.

# ── Grok (xAI) ────────────────────────────────────────────────────────────────
# Get key at: https://console.x.ai
GROK_API_KEY=xai-...

# ── Google Analytics ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Get from: https://dashboard.stripe.com/webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Get from: Stripe product page after creating $9.99/mo price
STRIPE_PRICE_ID_PRO_MONTHLY=price_...

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-site.netlify.app
NEXTAUTH_SECRET=<run: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))">

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app
# URL of deployed excel-service (Railway/Fly.io). Use http://localhost:8000 locally.
PYTHON_SERVICE_URL=http://localhost:8000

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to require Stripe subscription before showing the full model
NEXT_PUBLIC_GATE_ENABLED=false
